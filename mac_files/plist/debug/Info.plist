<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleVersion</key>
    <string>@FULL_VERSION@</string>
    <key>CFBundleShortVersionString</key>
    <string>@FULL_VERSION@</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>

    <key>CFBundleName</key>
    <string>EddyFlow</string>
    <key>CFBundleDevelopmentRegion</key>
    <string>en-US</string>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>CFBundleIconFile</key>
    <string>@ICON@</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleSignature</key>
    <string>edpr</string>
    <key>CFBundleExecutable</key>
    <string>@EXECUTABLE@</string>
    <key>CFBundleIdentifier</key>
    <string>io.github.kebasaa.eddyflow-debug</string>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2026 ETH Zurich. Based on EddyPro, copyright © 2011-2019 LI-COR Inc.</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.education</string>
    <key>LSMinimumSystemVersion</key>
    <string>${MACOSX_DEPLOYMENT_TARGET}</string>
    <key>NSSupportsAutomaticGraphicsSwitching</key>
    <true/>

    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeIconFile</key>
            <string>@ICON@</string>
            <key>CFBundleTypeName</key>
            <string>EddyFlow Project File</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Owner</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>io.github.kebasaa.eddyflow-debug.project</string>
            </array>
        </dict>
    </array>

    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>io.github.kebasaa.eddyflow-debug.project</string>
            <key>UTTypeDescription</key>
            <string>EddyFlow Project File</string>
            <key>UTTypeIconFile</key>
            <string>@ICON@</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.text</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>eddyflow</string>
                </array>
            </dict>
        </dict>
    </array>
</dict>
</plist>
